{
  "name": "@kinship/api",
  "version": "0.3.0-rc.4",
  "private": true,
  "description": "KinShip API",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm --filter @kinship/shared build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @kinship/shared build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@kinship/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
