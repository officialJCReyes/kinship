# KinShip settings. Copy this file to `.env`, edit it, and keep it private:
#   cp .env.example .env && chmod 600 .env
# Never commit `.env`. Secrets can also be supplied as Docker secrets: for any
# secret below, set NAME_FILE=/run/secrets/<file> instead of NAME.
#
# This file lists the settings that exist in release 0.1. Settings for later
# features (file encryption, email, S3, maps, backups) are added with the
# release that introduces them. Every new setting has a default.

# --- Public address -----------------------------------------------------------
# The address people type into the browser, as seen from outside (your reverse
# proxy's address, with https:// if it terminates TLS). No trailing slash.
# Used in the first-run message that tells you where to finish setup.
PUBLIC_URL=http://localhost:8080

# --- Sign-in and sessions -----------------------------------------------------
# Is a reverse proxy in front of KinShip? Then tell the API which addresses to believe
# when they say "this request came from visitor X over HTTPS" (X-Forwarded-For and
# -Proto). Without it the sign-in cookie is not marked Secure behind an HTTPS proxy and
# every visitor looks like the proxy's address. Use a comma-separated list of the
# proxy's address or range, or "true" to trust every hop. Leave "false" if nothing
# sits in front of the web container.
# Docker networks are usually inside 172.16.0.0/12; your own proxy may be elsewhere.
TRUST_PROXY=false
# A session ends after this many days without use ...
SESSION_IDLE_DAYS=14
# ... and, however busy, this many days after sign-in.
SESSION_MAX_DAYS=90

# --- Database -----------------------------------------------------------------
# Two database roles are used. The owner role creates and changes tables
# (migrations only). The app role is what the API uses for requests; it cannot
# change the schema, and Postgres row-level security applies to it.
DB_HOST=db
DB_PORT=5432
DB_NAME=kinship
DB_OWNER_USER=kinship
DB_APP_USER=kinship_app

# Secrets. Replace both placeholders with long random values, for example:
#   openssl rand -base64 24
# They must be different from each other. Alternatively use
# DB_OWNER_PASSWORD_FILE and DB_APP_PASSWORD_FILE.
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app

# --- API process --------------------------------------------------------------
# Normally left alone: the Docker images already set sensible values.
# Address and port the API listens on inside its container. Only the web
# container talks to it; it is never published to the host.
API_HOST=0.0.0.0
API_PORT=3000
# Folder of numbered .sql migrations. The image ships them next to the code, so
# this is only for development or testing a custom set.
# MIGRATIONS_DIR=/app/apps/api/migrations
# Short git commit shown by /api/version. The published images set this at
# build time; leave it unset ("unknown") when running from a checkout.
# GIT_COMMIT=

# --- Logging ------------------------------------------------------------------
# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
