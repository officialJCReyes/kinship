# KinShip settings. Copy this file to `.env`, edit it, and keep it private:
#   cp .env.example .env && chmod 600 .env
# Never commit `.env`. Secrets can also be supplied as Docker secrets: for any
# secret below, set NAME_FILE=/run/secrets/<file> instead of NAME.
#
# This file lists the settings that exist in release 0.1. Settings for later
# features (file encryption, email, S3, maps, backups) are added with the
# release that introduces them. Every new setting has a default.

# --- Public address -----------------------------------------------------------
# The address people type into the browser, as seen from outside (your reverse
# proxy's address, with https:// if it terminates TLS). No trailing slash.
PUBLIC_URL=http://localhost:8080

# --- Database -----------------------------------------------------------------
# Two database roles are used. The owner role creates and changes tables
# (migrations only). The app role is what the API uses for requests; it cannot
# change the schema, and Postgres row-level security applies to it.
DB_HOST=db
DB_PORT=5432
DB_NAME=kinship
DB_OWNER_USER=kinship
DB_APP_USER=kinship_app

# Secrets. Replace both placeholders with long random values, for example:
#   openssl rand -base64 24
# They must be different from each other. Alternatively use
# DB_OWNER_PASSWORD_FILE and DB_APP_PASSWORD_FILE.
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app

# --- Logging ------------------------------------------------------------------
# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
