{
  "name": "kinship",
  "version": "0.3.0-rc.4",
  "private": true,
  "description": "Self-hosted family tree: relationships, sources, photos, private health history and DNA results.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officialJCReyes/kinship.git"
  },
  "bugs": "https://github.com/officialJCReyes/kinship/issues",
  "homepage": "https://github.com/officialJCReyes/kinship#readme",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . && node scripts/check-spdx.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,yml,yaml,css,html}\"",
    "licenses:check": "node scripts/check-licenses.mjs",
    "test:scripts": "node --test scripts/"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
